rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function auth() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function myEmail() {
      return auth() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }
    function isMainManager() {
      return myEmail() in [
        'apolich97@gmail.com',
        'abode212k@gmail.com'
      ];
    }
    function inviteRole() {
      return myEmail() != ''
          && exists(/databases/$(database)/documents/staff_invites/$(myEmail()))
          && get(/databases/$(database)/documents/staff_invites/$(myEmail())).data.active != false
        ? get(/databases/$(database)/documents/staff_invites/$(myEmail())).data.role
        : 'customer';
    }
    // أولوية للدعوة النشطة والمدير الرئيسي لمنع بقاء الصلاحيات بعد حذف الموظف.
    function roleOf() {
      return isMainManager()
        ? 'manager'
        : (inviteRole() != 'customer'
            ? inviteRole()
            : ((exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
                  'manager', 'marketer', 'accounting', 'shipping', 'support', 'courier'
                ]
                && (myEmail() == ''
                    || !exists(/databases/$(database)/documents/staff_invites/$(myEmail()))
                    || get(/databases/$(database)/documents/staff_invites/$(myEmail())).data.active != false))
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
              : 'customer'));
    }
    function staff() {
      return auth() && (isMainManager() || roleOf() in [
        'manager', 'marketer', 'accounting', 'shipping', 'support', 'courier'
      ]);
    }
    function isManager() {
      return auth() && (isMainManager() || roleOf() == 'manager');
    }
    function proofOk(p, minAmount) {
      return p.proofUrl is string && p.proofUrl.size() > 0
        && p.amount is number && p.amount >= minAmount
        && p.senderName is string && p.senderName.size() >= 3;
    }
    function dueOf(d) {
      return d.upfrontDueLocal is number && d.upfrontDueLocal > 0
        ? d.upfrontDueLocal : d.totalLocal;
    }

    match /users/{uid} {
      allow read: if auth() && (uid == me() || staff());
      allow create: if auth() && uid == me() && (
        !request.resource.data.keys().hasAny(['role'])
        || request.resource.data.role == 'customer'
        || (inviteRole() != 'customer' && request.resource.data.role == inviteRole())
        || isMainManager()
      );
      allow update: if auth() && uid == me() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        || (inviteRole() != 'customer' && request.resource.data.role == inviteRole())
        || isMainManager()
      );
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        && request.resource.data.role in ['customer','marketer','manager','accounting','shipping','courier','support'];
      allow update: if isManager()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow update: if staff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['staffNotes', 'notesUpdatedAt', 'notesUpdatedBy', 'customerTier', 'deferredCreditLimitSar']);
      allow delete: if isManager();
      match /addresses/{a} { allow read, write: if auth() && (uid == me() || staff()); }
      match /cart/{c} { allow read: if auth() && uid == me(); allow write: if false; }
    }

    match /orders/{o} {
      allow read: if auth() && (resource.data.userId == me() || staff());
      allow create: if auth() && request.resource.data.userId == me()
        && request.resource.data.status in ['unpaid','verifying']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && request.resource.data.totalSar is number
        && (request.resource.data.status != 'verifying'
            || proofOk(request.resource.data.payment, dueOf(request.resource.data)));
      allow update: if auth() && resource.data.userId == me()
        && resource.data.status in ['unpaid','verifying']
        && request.resource.data.status in ['unpaid','verifying','cancelled']
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.totalSar == resource.data.totalSar
        && request.resource.data.exchangeRate == resource.data.exchangeRate
        && request.resource.data.totalLocal == resource.data.totalLocal
        && (request.resource.data.status != 'verifying'
            || proofOk(request.resource.data.payment, dueOf(resource.data)));
      // تسجيل إرسال استمارة واتساب وصورة الملخص
      allow update: if auth() && resource.data.userId == me()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['whatsappSentAt', 'whatsappSentTarget', 'orderSummaryImageUrl', 'updatedAt']);
      // موافقة أو رفض مزامنة السعر/المخزون
      allow update: if auth() && resource.data.userId == me()
        && resource.data.priceSyncStatus == 'pending_customer'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['priceSyncStatus', 'priceSyncDecision', 'priceSyncRespondedAt', 'updatedAt'])
        && request.resource.data.priceSyncStatus in ['accepted', 'rejected'];
      // إرسال بديل من العميل عند نفاد قطعة (نفس القيمة أو بفارق)
      allow update: if auth() && resource.data.userId == me()
        && resource.data.replacementStatus == 'pending_customer'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['replacementStatus', 'replacementProposal', 'replacementSubmittedAt', 'updatedAt'])
        && request.resource.data.replacementStatus == 'pending_admin';
      // التوقيع الإلكتروني باستلام الطلب من العميل
      allow update: if auth() && resource.data.userId == me()
        && resource.data.status in ['shipped', 'outForDelivery']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['customerSignatureUrl', 'signedAt', 'signedByUid', 'signedByName', 'deliverySigned', 'deliveryPinVerified', 'shippingStage', 'status', 'timeline', 'updatedAt'])
        && request.resource.data.customerSignatureUrl is string
        && request.resource.data.customerSignatureUrl.size() > 0;
      // تحديث بيانات حساب الاسترداد
      allow update: if auth() && resource.data.userId == me()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['refunds', 'updatedAt'])
        && request.resource.data.refundedTotalSar == resource.data.refundedTotalSar
        && request.resource.data.status == resource.data.status;

      // صلاحيات الطاقم المقسمة بدقة حسب الدور:
      allow update: if isManager();
      allow update: if roleOf() == 'accounting'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'payment', 'paidTotalLocal', 'remainingLocal', 'upfrontDueLocal',
                       'refunds', 'refundedTotalSar', 'editingLocked', 'approvedAt', 'approvedByName',
                       'priceSyncStatus', 'replacementStatus', 'items', 'subtotalSar', 'totalSar', 'totalLocal',
                       'timeline', 'updatedAt']);
      allow update: if roleOf() in ['shipping', 'courier']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'shippingStage', 'shippingStageNote', 'shippingStageUpdatedAt',
                       'shippingWaybill', 'deliveryWaybill', 'trackingNo', 'trackingUrl', 'trackingImageUrl',
                       'courierName', 'courierPhone', 'proofImageUrl',
                       'customerSignatureUrl', 'signedAt', 'signedByUid', 'signedByName', 'deliverySigned',
                       'deliveryPinVerified', 'timeline', 'updatedAt']);
      allow update: if roleOf() == 'support'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['priceSyncStatus', 'priceSyncNote', 'proposedItems', 'proposedSubtotalSar',
                       'proposedTotalSar', 'proposedTotalLocal', 'replacementStatus', 'replacementAlert', 'replacementProposal',
                       'items', 'refunds', 'supportNotes', 'timeline', 'updatedAt']);

      allow delete: if isManager();

      match /events/{e} {
        allow read, create: if auth() && (get(/databases/$(database)/documents/orders/$(o)).data.userId == me() || staff());
        allow update: if false;
        allow delete: if isManager();
      }
      match /receipts/{r} {
        allow read: if auth() && (get(/databases/$(database)/documents/orders/$(o)).data.userId == me() || staff());
        allow create: if auth()
          && request.resource.data.source == 'customer'
          && request.resource.data.status == 'pending'
          && request.resource.data.proofUrl is string
          && request.resource.data.proofUrl.size() > 0
          && request.resource.data.amountLocal is number
          && request.resource.data.amountLocal > 0
          && get(/databases/$(database)/documents/orders/$(o)).data.userId == me();
        allow update: if isManager() || roleOf() == 'accounting';
        allow delete: if isManager();
      }
      match /messages/{m} {
        allow read, create: if auth() && (get(/databases/$(database)/documents/orders/$(o)).data.userId == me() || staff());
        allow update: if false;
        allow delete: if isManager();
      }
    }

    match /support_threads/{t} {
      allow read: if auth() && (resource.data.userId == me() || staff());
      allow create: if auth() && request.resource.data.userId == me();
      allow update: if auth() && (resource.data.userId == me() || staff());
      allow delete: if isManager();
      match /messages/{m} {
        allow read, create: if auth() && (get(/databases/$(database)/documents/support_threads/$(t)).data.userId == me() || staff());
        allow update: if false;
        allow delete: if isManager();
      }
    }
    match /support_query_logs/{q} {
      allow create: if auth();
      allow read, update: if staff();
      allow delete: if isManager();
    }
    match /support_guide/{g} {
      allow read: if auth();
      allow write: if staff();
    }
    match /support_faq_ignored/{f} { allow read, write: if staff(); }

    match /staff_invites/{email} {
      allow read: if isManager() || (auth() && myEmail() == email.lower());
      allow write: if isManager();
    }

    match /{path=**}/receipts/{r} {
      allow read: if auth() && (resource.data.customerId == me() || staff());
    }

    match /products/{g} { allow read: if true; allow write: if staff(); }
    match /catalog/{c} {
      allow read: if true;
      allow create, update: if auth() && (isManager() || roleOf() == 'marketer');
      allow delete: if isManager();
    }
    match /coupons/{c} {
      allow read: if auth();
      allow create, update: if staff();
      allow delete: if isManager();
    }
    match /settings/{s} {
      allow read: if true;
      allow write: if isManager();
    }
    match /shein_cache/{g} { allow read: if true; allow write: if staff(); }

    match /checkout_alerts/{a} {
      allow read: if true;
      allow create, update: if auth() && roleOf() in ['manager', 'support', 'shipping'];
      allow delete: if isManager();
    }

    match /notifications/{uid}/items/{n} {
      allow read, update, delete: if auth() && (uid == me() || isManager());
      allow create: if auth() && (uid == me() || staff());
    }

    match /audit_logs/{a} {
      allow create: if staff();
      allow read: if isManager();
      allow update: if false;
      allow delete: if isMainManager();
    }

    match /deleted_records/{d} {
      allow create: if isManager();
      allow read: if isManager();
      allow update: if false;
      allow delete: if isMainManager();
    }

    match /counters/{c} {
      allow read: if auth();
      allow create, update: if staff() && request.resource.data.value is number;
      allow create: if auth() && c == 'orders' && request.resource.data.value == 1;
      allow update: if auth() && c == 'orders'
        && request.resource.data.value == resource.data.value + 1;
      allow delete: if isManager();
    }
    match /order_numbers/{no} {
      allow read: if auth();
      allow create: if auth() && request.resource.data.userId == me();
      allow update: if false;
      allow delete: if isManager();
    }
    match /wallets/{uid} {
      allow read: if auth() && (uid == me() || staff());
      allow create, update: if isManager() || roleOf() == 'accounting';
      allow update: if auth() && uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceSar', 'movements', 'updatedAt'])
        && request.resource.data.balanceSar is number
        && request.resource.data.balanceSar >= 0
        && request.resource.data.balanceSar <= resource.data.balanceSar
        && request.resource.data.movements is list
        && request.resource.data.movements.size() >= resource.data.movements.size();
      allow delete: if isManager();
    }
    match /wallet_requests/{r} {
      allow read: if auth() && (resource.data.userId == me() || staff());
      allow create: if auth() && request.resource.data.userId == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.amountSar is number
        && request.resource.data.amountSar > 0;
      allow update: if isManager() || roleOf() == 'accounting';
      allow delete: if isManager();
    }
    match /reviews/{r} {
      allow read: if true;
      allow create: if auth() && request.resource.data.userId == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.rating is number
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() > 0;
      allow update: if staff();
      allow delete: if isManager();
    }
    match /meta/{m} { allow read: if true; allow write: if staff(); }
    match /alerts/{a} { allow read, update: if staff(); allow create: if false; allow delete: if isManager(); }
    match /staff_alerts/{a} {
      allow create: if auth()
        && request.resource.data.target is string
        && request.resource.data.orderId is string;
      allow read, update: if staff();
      allow delete: if isManager();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
