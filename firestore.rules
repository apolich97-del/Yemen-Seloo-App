rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function auth() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // المديران الرئيسيان فقط — كل الصلاحيات الإدارية.
    function isMainManager() {
      return auth() && request.auth.token.email in [
        'apolich97@gmail.com',
        'abode212k@gmail.com'
      ];
    }
    // دور المستخدم من وثيقة users/{uid} (عميل إن لم توجد).
    function roleOf() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'customer';
    }
    // فريق العمل: المديران الرئيسيان أو أي دور موزّع من لوحة الفريق.
    function staff() {
      return auth() && (isMainManager() || roleOf() in [
        'manager', 'marketer', 'accounting', 'shipping', 'support', 'courier'
      ]);
    }
    function proofOk(p, minAmount) {
      return p.proofUrl is string && p.proofUrl.size() > 0
        && p.amount is number && p.amount >= minAmount
        && p.senderName is string && p.senderName.size() >= 3;
    }
    // المبلغ المطلوب: الدفعة الأولى في الطلب الآجل، وإلا الإجمالي
    function dueOf(d) {
      return d.upfrontDueLocal is number && d.upfrontDueLocal > 0
        ? d.upfrontDueLocal : d.totalLocal;
    }

    match /users/{uid} {
      allow read: if auth() && (uid == me() || staff());
      allow create: if auth() && uid == me() && !request.resource.data.keys().hasAny(['role']);
      allow update: if auth() && uid == me() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','fcmTokens']);
      // تغيير الأدوار والصلاحيات: المدير الرئيسي فقط
      allow update: if isMainManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        && request.resource.data.role in ['customer','manager','accounting','shipping','courier','support'];
      allow update: if isMainManager()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isMainManager();
      match /addresses/{a} { allow read, write: if auth() && (uid == me() || staff()); }
      match /cart/{c} { allow read: if auth() && uid == me(); allow write: if false; }
    }

    match /orders/{o} {
      allow read: if auth() && (resource.data.userId == me() || staff());
      allow create: if auth() && request.resource.data.userId == me()
        && request.resource.data.status in ['unpaid','verifying']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && request.resource.data.totalSar is number
        && (request.resource.data.status != 'verifying'
            || proofOk(request.resource.data.payment, dueOf(request.resource.data)));
      allow update: if auth() && resource.data.userId == me()
        && resource.data.status in ['unpaid','verifying']
        && request.resource.data.status in ['unpaid','verifying','cancelled']
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.totalSar == resource.data.totalSar
        && (request.resource.data.status != 'verifying'
            || proofOk(request.resource.data.payment, dueOf(resource.data)));
      allow update: if staff();
      allow delete: if false;
      match /events/{e} {
        allow read, create: if auth() && (get(/databases/$(database)/documents/orders/$(o)).data.userId == me() || staff());
        allow update, delete: if false;
      }
      match /receipts/{r} {
        allow read: if auth() && (get(/databases/$(database)/documents/orders/$(o)).data.userId == me() || staff());
        // العميل ينشئ إيصالاً معلّقاً فقط، وبصورة إلزامية
        allow create: if auth()
          && request.resource.data.source == 'customer'
          && request.resource.data.status == 'pending'
          && request.resource.data.proofUrl is string
          && request.resource.data.proofUrl.size() > 0
          && request.resource.data.amountLocal is number
          && request.resource.data.amountLocal > 0
          && get(/databases/$(database)/documents/orders/$(o)).data.userId == me();
        // الاعتماد والخصم من الأرصدة: للطاقم فقط
        allow update, delete: if staff();
      }
      match /messages/{m} {
        allow read, create: if auth() && (get(/databases/$(database)/documents/orders/$(o)).data.userId == me() || staff());
        allow update, delete: if false;
      }
    }

    // ═══ الدعم: محادثات العملاء + سجل الأسئلة + الدليل المعتمد ═══
    match /support_threads/{t} {
      allow read: if auth() && (resource.data.userId == me() || staff());
      allow create: if auth() && request.resource.data.userId == me();
      allow update: if auth() && (resource.data.userId == me() || staff());
      allow delete: if false;
      match /messages/{m} {
        allow read: if auth() && (get(/databases/$(database)/documents/support_threads/$(t)).data.userId == me() || staff());
        allow create: if auth() && (get(/databases/$(database)/documents/support_threads/$(t)).data.userId == me() || staff());
        allow update, delete: if false;
      }
    }
    match /support_query_logs/{q} {
      allow create: if auth();
      allow read, update, delete: if staff();
    }
    match /support_guide/{g} {
      allow read: if auth();
      allow write: if staff();
    }
    match /support_faq_ignored/{f} { allow read, write: if staff(); }

    // سجل الفريق: المدير الرئيسي يضيف/يعدّل/يزيل، والموظف يقرأ سجله فقط.
    match /staff_invites/{email} {
      allow read: if isMainManager() ||
        (auth() && request.auth.token.email == email);
      allow write: if isMainManager();
    }

    match /products/{g} { allow read: if true; allow write: if staff(); }
    // كتالوج يمن سيلو: قراءة عامة، كتابة للمسوّق والمدير الرئيسي فقط.
    match /catalog/{c} {
      allow read: if true;
      allow write: if auth() && (
        isMainManager() || roleOf() == 'marketer' || roleOf() == 'manager'
      );
    }
    match /coupons/{c} { allow read: if auth(); allow write: if staff(); }
    match /settings/{s} { allow read: if auth(); allow write: if staff(); }
    // عدّادات متسلسلة (أرقام الإيصالات) — القراءة والزيادة الذرية للمسجلين
    match /counters/{c} {
      allow read: if auth();
      allow create, update: if auth() && request.resource.data.value is number;
      allow delete: if staff();
    }
    match /meta/{m} { allow read: if true; allow write: if staff(); }
    match /alerts/{a} { allow read, update: if staff(); allow create: if false; }
    // تنبيهات الموظفين (مثل إلغاء طلب مدفوع) — العميل ينشئ، الفريق يقرأ
    match /staff_alerts/{a} {
      allow create: if auth()
        && request.resource.data.target is string
        && request.resource.data.orderId is string;
      allow read, update, delete: if staff();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
